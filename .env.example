TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_TELEGRAM_ID=123456789
LLM_PROVIDER=gemini
MODEL=gemini-3.5-flash
GOOGLE_API_KEY=replace_me
TAVILY_API_KEY=tvly-replace_me
SCAN_INTERVAL_MINUTES=60
DB_PATH=./data/monitor.db
TIMEZONE=Europe/Amsterdam
MAX_SEARCH_RESULTS=6
LOOKBACK_DAYS=3
LLM_BATCH_SIZE=20
# SEC EDGAR требует User-Agent с контактом (иначе 403)
USER_AGENT=corporate-events-monitor/1.0 (your-email@example.com)
# Email-дублирование уведомлений (необязательно). Примеры:
# Gmail: SMTP_HOST=smtp.gmail.com, порт 465, пароль приложения (myaccount.google.com/apppasswords)
# Яндекс: SMTP_HOST=smtp.yandex.ru, порт 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Railway блокирует SMTP — там используйте SendGrid HTTP API:
# SENDGRID_API_KEY=SG.xxx  (+ EMAIL_FROM = верифицированный в SendGrid отправитель)
SENDGRID_API_KEY=
